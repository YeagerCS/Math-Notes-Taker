PORT=3000
DATABASE_URL=postgres://mathnotes:CHANGE_ME@localhost:5432/mathnotes
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Generate with: npm run hash-password -- 'your password'   (no argument = generate a password)
ADMIN_PASSWORD_HASH=scrypt:...
# At least 32 random characters, e.g. `openssl rand -base64 48`. Changing it logs out every device.
JWT_SECRET=CHANGE_ME
# Lockout after this many wrong passwords in a row; lock duration in minutes (0 = until unlocked manually)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
